# ========== Linear Random Forest (approximate implementation) ==========
class LinearDecisionTree:
    """Approximates the M5 algorithm: a standard decision tree with a
    (Ridge) linear model fitted at each leaf."""

    def __init__(self, max_depth=5, min_samples_split=10, min_samples_leaf=5, random_state=None):
        self.max_depth = max_depth
        self.min_samples_split = min_samples_split
        self.min_samples_leaf = min_samples_leaf
        self.random_state = random_state
        self.tree = None
        self.linear_models = {}

    def fit(self, X, y):
        np.random.seed(self.random_state)
        self.tree = DecisionTreeRegressor(
            max_depth=self.max_depth,
            min_samples_split=self.min_samples_split,
            min_samples_leaf=self.min_samples_leaf,
            random_state=self.random_state,
        ).fit(X, y)

        leaf_indices = self.tree.apply(X)
        for leaf_id in np.unique(leaf_indices):
            mask = leaf_indices == leaf_id
            X_leaf, y_leaf = X[mask], y[mask]
            if len(X_leaf) >= 2:
                try:
                    # Ridge regression instead of OLS to prevent coefficient
                    # explosion caused by near-singular leaf matrices when
                    # sample count is small (especially during k-fold CV).
                    # alpha=1.0 provides mild regularization consistent with
                    # the L2 strength used in the MLP model.
                    self.linear_models[leaf_id] = Ridge(alpha=1.0).fit(X_leaf, y_leaf)
                except Exception:
                    self.linear_models[leaf_id] = np.mean(y_leaf)
            else:
                self.linear_models[leaf_id] = np.mean(y_leaf)

    def predict(self, X):
        leaf_indices = self.tree.apply(X)
        predictions = np.zeros(len(X))
        for i, leaf_id in enumerate(leaf_indices):
            model = self.linear_models.get(leaf_id)
            if model is None:
                predictions[i] = self.tree.predict(X[i : i + 1])[0]
            elif hasattr(model, "predict"):
                predictions[i] = model.predict(X[i : i + 1])[0]
            else:
                predictions[i] = model

        # Clip predictions to the physical temperature range. Prevents
        # numerically unstable leaf models from producing wildly
        # extrapolated values, especially in k-fold CV folds whose
        # validation set extends near the boundary of the training range.
        return np.clip(predictions, *TEMP_RANGE)


class ApproximateLinearRandomForest:
    """Approximate Linear Random Forest: random sample bipartition
    (train/pruning) + random feature selection + linear leaf models,
    averaged across trees (paper's Eq. 5)."""

    def __init__(self, n_estimators=100, max_depth=5, min_samples_split=10,
                 min_samples_leaf=5, max_features="sqrt", random_state=None):
        self.n_estimators = n_estimators
        self.max_depth = max_depth
        self.min_samples_split = min_samples_split
        self.min_samples_leaf = min_samples_leaf
        self.max_features = max_features
        self.random_state = random_state
        self.estimators_ = []
        self.feature_importances_ = None

    def _resolve_max_features(self, n_features):
        if self.max_features == "sqrt":
            return int(np.sqrt(n_features))
        if self.max_features == "log2":
            return int(np.log2(n_features))
        if isinstance(self.max_features, int):
            return min(self.max_features, n_features)
        return n_features

    def fit(self, X, y):
        np.random.seed(self.random_state)
        random.seed(self.random_state)
        y = y.values if hasattr(y, "values") else y

        n_samples, n_features = X.shape
        self.max_features_ = self._resolve_max_features(n_features)

        print(f"Training Linear Random Forest with {self.n_estimators} trees...")
        print(f"   - Max features per tree: {self.max_features_}")
        print("   - Sample bipartition: 80% training, 20% pruning per tree (optimized for small datasets)")
        print(f"   - Training samples per tree: ~{int(n_samples * 0.8)}")
        print(f"   - Pruning samples per tree: ~{int(n_samples * 0.2)}")

        for i in range(self.n_estimators):
            # 1. Random sample bipartition (80% train / 20% pruning)
            indices = np.random.choice(n_samples, size=n_samples, replace=False)
            train_size = int(n_samples * 0.8)
            train_idx, prune_idx = indices[:train_size], indices[train_size:]
            X_tr, y_tr = X[train_idx], y[train_idx]
            X_pr, y_pr = X[prune_idx], y[prune_idx]

            # 2. Random feature selection
            feat_idx = np.random.choice(n_features, size=self.max_features_, replace=False)

            # 3. Linear decision tree on selected features
            tree = LinearDecisionTree(
                max_depth=self.max_depth,
                min_samples_split=self.min_samples_split,
                min_samples_leaf=self.min_samples_leaf,
                random_state=self.random_state + i,
            )
            tree.fit(X_tr[:, feat_idx], y_tr)

            self.estimators_.append({
                "tree": tree,
                "feature_indices": feat_idx,
                "train_score": r2_score(y_tr, tree.predict(X_tr[:, feat_idx])),
                "prune_score": r2_score(y_pr, tree.predict(X_pr[:, feat_idx])) if len(X_pr) > 0 else 0,
            })

            if (i + 1) % 20 == 0:
                print(f"   - Trained {i + 1}/{self.n_estimators} trees")

        self._calculate_feature_importance(X, y)
        print("Linear Random Forest training completed!")

    def _calculate_feature_importance(self, X, y):
        importances = np.zeros(X.shape[1])
        for est in self.estimators_:
            base_tree = est["tree"].tree
            if hasattr(base_tree, "feature_importances_"):
                for i, feat_idx in enumerate(est["feature_indices"]):
                    if i < len(base_tree.feature_importances_):
                        importances[feat_idx] += base_tree.feature_importances_[i]
        total = importances.sum()
        self.feature_importances_ = importances / total if total > 0 else importances

    def predict(self, X):
        predictions = np.column_stack([
            est["tree"].predict(X[:, est["feature_indices"]]) for est in self.estimators_
        ])
        return predictions.mean(axis=1)  # ensemble average (paper's Eq. 5)

    def get_model_info(self):
        train_scores = [e["train_score"] for e in self.estimators_]
        prune_scores = [e["prune_score"] for e in self.estimators_]
        return {
            "n_estimators": self.n_estimators,
            "max_depth": self.max_depth,
            "max_features": self.max_features_,
            "avg_train_score": np.mean(train_scores),
            "avg_prune_score": np.mean(prune_scores),
            "model_type": "Linear Random Forest (Approximate)",
        }


# ========== File I/O and feature extraction ==========
def select_files(title):
    root = tk.Tk()
    root.withdraw()
    files = askopenfilenames(title=title, filetypes=[("CSV files", "*.csv")])
    return sorted(files)


def read_xy(file):
    try:
        df = pd.read_csv(file, header=0, encoding="utf-8")
    except UnicodeDecodeError:
        df = pd.read_csv(file, header=0, encoding="cp949")
    x = pd.to_numeric(df.iloc[:, 0], errors="coerce")
    y = pd.to_numeric(df.iloc[:, 3], errors="coerce")
    return x.dropna().values, y.dropna().values


def parse_info(file_name):
    """Extract (set_name, temperature) from a filename, e.g. 'Set1_25.0C'."""
    m = re.search(r"(Set\d+).*?([0-9]+(?:\.[0-9]+)?)\s*[°º]?\s*[C℃]", file_name)
    return (m.group(1), float(m.group(2))) if m else ("Unknown", np.nan)


def extract_peak_ev(x, y):
    if len(x) == 0 or len(y) == 0:
        return np.nan
    return 1240 / x[np.argmax(y)]


def extract_ex_ratio(x, y):
    main_mask = (x >= 370) & (x <= 380)
    shoulder_mask = (x >= 340) & (x <= 350)
    if not main_mask.any() or not shoulder_mask.any():
        return np.nan
    return np.max(y[shoulder_mask]) / np.max(y[main_mask])


def extract_ratio_400_shoulder(em_x, em_y, ex_x, ex_y):
    mask = (340 <= ex_x) & (ex_x <= 350)
    if not mask.any() or len(em_y) == 0:
        return np.nan
    return np.max(ex_y[mask]) / np.max(em_y)


def build_dataset(paths, include_set=False):
    """Match each EmScan file to its ExScan/Em(1)/Em(2) counterparts (same
    set, temperature within 0.2 degC) and compute the five descriptors."""
    records = []
    for file in paths:
        set_name, temp = parse_info(file)
        if "EmScan" not in file or set_name == "Unknown":
            continue

        related = lambda tag: [f for f in paths if tag in f and set_name in f]
        f_ex = next((f for f in related("ExScan") if abs(parse_info(f)[1] - temp) <= 0.2), None)
        f_em1 = next((f for f in related("Em(1)") if abs(parse_info(f)[1] - temp) <= 0.2), None)
        f_em2 = next((f for f in related("Em(2)") if abs(parse_info(f)[1] - temp) <= 0.2), None)
        if not all([f_ex, f_em1, f_em2]):
            continue

        try:
            x_em, y_em = read_xy(file)
            x_ex, y_ex = read_xy(f_ex)
            x_em1, y_em1 = read_xy(f_em1)
            x_em2, y_em2 = read_xy(f_em2)

            temps = [temp, parse_info(f_ex)[1], parse_info(f_em1)[1], parse_info(f_em2)[1]]
            T_avg = round(np.mean(temps), 2)

            row = {
                "Temperature": T_avg,
                "Excitation_ratio": extract_ex_ratio(x_ex, y_ex),
                "EmScan_peak_eV": extract_peak_ev(x_em, y_em),
                "Em1_peak_eV": extract_peak_ev(x_em1, y_em1),
                "Em2_peak_eV": extract_peak_ev(x_em2, y_em2),
                "Intensity_400nm_div_shoulder": extract_ratio_400_shoulder(x_em, y_em, x_ex, y_ex),
            }
            if include_set:
                row = {"Set": set_name, **row}

            if not any(np.isnan(row[c]) for c in FEATURE_COLUMNS):
                records.append(row)
        except Exception as e:
            print(f"Error processing file: {file}\n   Error: {e}")

    return pd.DataFrame(records)



# ========== Main ==========
def main():
    print("=" * 60)
    print("Linear Random Forest Temperature Prediction Model")
    print("=" * 60)

    print("\n[Step 1: Load Training and Validation Data]")
    train_val_paths = select_files("Select training and validation data files")
    if not train_val_paths:
        print("No files selected. Exiting program.")
        return
    print(f"{len(train_val_paths)} files selected.")

    df = build_dataset(train_val_paths, include_set=True)
    if df.empty:
        print("No valid data available for model training.")
        return
    print(f"\n{len(df)} valid data sets created.")

    X = df[FEATURE_COLUMNS]
    y = df["Temperature"]
    feature_names = FEATURE_COLUMNS

    print("\n[Step 2: Data Split]")
    X_train, X_val, y_train, y_val = train_test_split(X, y, test_size=0.2, random_state=RANDOM_STATE)
    print(f"Training set: {len(X_train)} samples, Validation set: {len(X_val)} samples")

    print("\n[Step 3: Apply Standard Scaling]")
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    print("Standard Scaling applied.")
    print_scaling_info(scaler, feature_names)

    print("\n[Step 4: Linear Random Forest Model Training]")
    print("Model Configuration (based on the paper):")
    print("  - Sample Bipartition: 80% training, 20% pruning per tree (optimized for small datasets)")
    print("  - Linear models in leaf nodes (M5-style post-pruning)")
    print("  - Random feature selection at each node")
    for k, v in LRF_PARAMS.items():
        print(f"  - {k}: {v}")

    lrf_model = ApproximateLinearRandomForest(**LRF_PARAMS, random_state=RANDOM_STATE)
    lrf_model.fit(X_train_scaled, y_train)

    print("\n[Step 5: Model Evaluation]")
    model_info = lrf_model.get_model_info()
    print(f"Average Tree Training Score: {model_info['avg_train_score']:.4f}")
    print(f"Average Tree Pruning Score: {model_info['avg_prune_score']:.4f}")

    run_cross_validation(X.values, y.values)

    print("\n[Step 6: Visualization]")
    root = tk.Tk()
    root.withdraw()
    viz_save_dir = filedialog.askdirectory(title="Select folder to save visualization results") or None
    print(f"Visualization save folder: {viz_save_dir}" if viz_save_dir
          else "No visualization save folder selected. Visualizations will only be displayed.")

    importances, indices = plot_feature_importance(lrf_model, feature_names, viz_save_dir)
    plot_2d_decision_boundary(lrf_model, X_train_scaled, y_train, feature_names, indices, viz_save_dir)
    if viz_save_dir:
        save_feature_importance_csv(feature_names, importances, viz_save_dir)

    print("\n[Step 7: Test Data Processing]")
    test_paths = select_files("Select test data files")
    test_eval = None
    if not test_paths:
        print("No test files selected.")
    else:
        df_test = build_dataset(test_paths, include_set=False)
        if df_test.empty:
            print("No valid test data available.")
        else:
            X_test_scaled = scaler.transform(df_test[FEATURE_COLUMNS])
            print("\nStandard Scaling applied to test data")
            print("\n[Test Results]")
            y_test = df_test["Temperature"]
            y_test_pred = lrf_model.predict(X_test_scaled)
            print_metrics("Test", y_test, y_test_pred)

            print("\n[Step 8: Save Results]")
            save_test_results(df_test, y_test, y_test_pred, model_info)
            test_eval = (y_test, y_test_pred)

    print_final_summary(lrf_model, model_info, feature_names, test_eval)

    if viz_save_dir:
        save_model_info_csv(lrf_model, model_info, viz_save_dir)


if __name__ == "__main__":
    main()

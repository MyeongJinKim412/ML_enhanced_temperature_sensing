# ========== Visualization ==========
def plot_feature_importance(model, feature_names, save_dir=None):
    print("\n[Visualizing feature importance...]")
    importances = model.feature_importances_
    indices = np.argsort(importances)[::-1]

    plt.figure()
    plt.title("Linear Random Forest Feature Importance", fontsize=16, fontweight="bold")
    bars = plt.bar(range(len(importances)), importances[indices], alpha=0.8)
    for bar, color in zip(bars, plt.cm.viridis(np.linspace(0, 1, len(importances)))):
        bar.set_color(color)

    plt.xlabel("Features", fontsize=12)
    plt.ylabel("Importance", fontsize=12)
    labels = [DISPLAY_NAMES.get(feature_names[i], feature_names[i]) for i in indices]
    plt.xticks(range(len(importances)), labels, rotation=45, ha="right")
    plt.grid(axis="y", alpha=0.3)
    for i, v in enumerate(importances[indices]):
        plt.text(i, v + 0.001, f"{v:.3f}", ha="center", va="bottom", fontsize=10)
    plt.tight_layout()

    if save_dir:
        path = os.path.join(save_dir, "lrf_feature_importance_plot.png")
        plt.savefig(path, dpi=300, bbox_inches="tight")
        print(f"Feature importance plot saved: {path}")
    plt.show()

    print("\n[Feature Importance Ranking]")
    print("-" * 70)
    print(f"{'Rank':<6}{'Feature Name':<30}{'Display Name':<20}{'Importance':<10}")
    print("-" * 70)
    for i, idx in enumerate(indices):
        name = feature_names[idx]
        print(f"{i+1:<6}{name:<30}{DISPLAY_NAMES.get(name, name):<20}{importances[idx]:.4f}")
    print("-" * 70)
    return importances, indices


def plot_2d_decision_boundary(model, X_train, y_train, feature_names, top_features_idx, save_dir=None):
    print("\n[Visualizing 2D decision boundary...]")
    f1_idx, f2_idx = top_features_idx[0], top_features_idx[1]
    f1_name, f2_name = feature_names[f1_idx], feature_names[f2_idx]
    f1_disp = DISPLAY_NAMES.get(f1_name, f1_name)
    f2_disp = DISPLAY_NAMES.get(f2_name, f2_name)

    X_2d = X_train[:, [f1_idx, f2_idx]]
    h = 0.02
    x_min, x_max = X_2d[:, 0].min() - 1, X_2d[:, 0].max() + 1
    y_min, y_max = X_2d[:, 1].min() - 1, X_2d[:, 1].max() + 1
    xx, yy = np.meshgrid(np.arange(x_min, x_max, h), np.arange(y_min, y_max, h))

    n_features = X_train.shape[1]
    grid_points = np.c_[xx.ravel(), yy.ravel()]
    full_grid = np.tile(X_train.mean(axis=0), (grid_points.shape[0], 1))
    full_grid[:, f1_idx] = grid_points[:, 0]
    full_grid[:, f2_idx] = grid_points[:, 1]
    Z = model.predict(full_grid).reshape(xx.shape)

    plt.figure()
    cmap, vmin, vmax = "coolwarm", *TEMP_RANGE
    plt.contourf(xx, yy, Z, levels=20, alpha=0.7, cmap=cmap, vmin=vmin, vmax=vmax)
    contour_lines = plt.contour(xx, yy, Z, levels=8, colors="white", alpha=0.8, linewidths=1.5)
    labels = plt.clabel(contour_lines, inline=True, fontsize=10, fmt="%.0f°C", inline_spacing=5)
    for label in labels:
        label.set_fontweight("bold")
    plt.colorbar(label="Predicted Temperature (°C)")
    plt.scatter(X_2d[:, 0], X_2d[:, 1], c=y_train, cmap=cmap, vmin=vmin, vmax=vmax,
                s=80, edgecolor="black", linewidth=1.2, alpha=0.9)
    plt.xlabel(f"{f1_disp} (Standardized)", fontsize=12)
    plt.ylabel(f"{f2_disp} (Standardized)", fontsize=12)
    plt.title(f"Linear Random Forest 2D Decision Boundary\n(Top 2 features: {f1_disp} vs {f2_disp})",
              fontsize=14, fontweight="bold")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()

    if save_dir:
        os.makedirs(save_dir, exist_ok=True)
        path = os.path.join(save_dir, "lrf_decision_boundary_2d.png")
        plt.savefig(path, dpi=300, bbox_inches="tight")
        print(f"2D decision boundary plot saved: {path}")
    plt.show()

    print("\nDecision boundary explanation:")
    print(f"- X-axis: {f1_disp} ({f1_name}) - standardized values")
    print(f"- Y-axis: {f2_disp} ({f2_name}) - standardized values")
    print("- Points: Training data samples (color = actual temperature)")
    print("- Background: Linear Random Forest predicted temperature for each region")


# ========== Cross-validation ==========
def run_cross_validation(X, y, n_splits=5):
    """5-fold CV: LRF re-instantiated with identical hyperparameters per
    fold; per-fold StandardScaler fitting (train fold only) prevents data
    leakage."""
    print("\n" + "=" * 60)
    print("5-Fold Cross-Validation (LRF)")
    print("=" * 60)

    kf = KFold(n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE)
    mae_list, r2_list = [], []

    for fold, (tr_idx, val_idx) in enumerate(kf.split(X), start=1):
        X_tr, X_vl = X[tr_idx], X[val_idx]
        y_tr, y_vl = y[tr_idx], y[val_idx]

        fold_scaler = StandardScaler()
        X_tr_sc = fold_scaler.fit_transform(X_tr)
        X_vl_sc = fold_scaler.transform(X_vl)

        fold_model = ApproximateLinearRandomForest(**LRF_PARAMS, random_state=RANDOM_STATE)
        fold_model.fit(X_tr_sc, y_tr)
        y_vl_pred = fold_model.predict(X_vl_sc)

        fold_mae = mean_absolute_error(y_vl, y_vl_pred)
        fold_r2 = r2_score(y_vl, y_vl_pred)
        mae_list.append(fold_mae)
        r2_list.append(fold_r2)
        print(f"  Fold {fold}: MAE = {fold_mae:.4f} °C,  R² = {fold_r2:.4f}")

    print(f"\n  Mean MAE = {np.mean(mae_list):.4f} ± {np.std(mae_list, ddof=1):.4f} °C  (mean ± SD, k={n_splits})")
    print(f"  Mean R²  = {np.mean(r2_list):.4f} ± {np.std(r2_list, ddof=1):.4f}       (mean ± SD, k={n_splits})")
    print("=" * 60)


# ========== Output ==========
def save_test_results(df_test, y_test, y_test_pred, model_info):
    results = df_test.copy()
    results["Predicted_Temperature"] = y_test_pred
    results["Residual"] = y_test - y_test_pred
    results["Abs_Residual"] = (y_test - y_test_pred).abs()
    results["R2_Score"] = r2_score(y_test, y_test_pred)
    results["MAE"] = mean_absolute_error(y_test, y_test_pred)
    results["Model_Type"] = model_info["model_type"]
    results["N_Estimators"] = model_info["n_estimators"]
    results["Max_Depth"] = model_info["max_depth"]
    results["Max_Features"] = model_info["max_features"]
    results["Avg_Train_Score"] = model_info["avg_train_score"]
    results["Avg_Prune_Score"] = model_info["avg_prune_score"]

    save_path = asksaveasfilename(
        title="Save Linear Random Forest test set prediction results",
        defaultextension=".csv",
        filetypes=[("CSV files", "*.csv")],
        initialfile="lrf_test_results_standard_scaled_lrf.csv",
    )
    if save_path and not os.path.isdir(save_path):
        results.to_csv(save_path, index=False, encoding="utf-8-sig")
        print(f"Linear Random Forest test set prediction results saved: {save_path}")
    else:
        print("Failed to save test results.")



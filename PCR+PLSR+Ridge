if summary_save_dir:
    summary_path = os.path.join(summary_save_dir, "plsr_pcr_ridge_summary.csv")
    summary_df.to_csv(summary_path, index=False, encoding='utf-8-sig')
    print(f"\nConsolidated summary CSV saved: {summary_path}")
else:
    print("\nNo save folder selected for summary CSV; summary was only printed above.")

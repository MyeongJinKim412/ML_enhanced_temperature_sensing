import os
import re
import random
import warnings
import tkinter as tk
from tkinter import filedialog
from tkinter.filedialog import askopenfilenames, asksaveasfilename

import numpy as np
import pandas as pd
from sklearn.inspection import partial_dependence
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import KFold, train_test_split
from sklearn.neural_network import MLPRegressor
from sklearn.preprocessing import StandardScaler

warnings.filterwarnings("ignore")

RANDOM_STATE = 42
random.seed(RANDOM_STATE)
np.random.seed(RANDOM_STATE)

FEATURE_COLUMNS = [
    "Excitation_ratio",
    "EmScan_peak_eV",
    "Em1_peak_eV",
    "Em2_peak_eV",
    "Intensity_400nm_div_shoulder",
]

MLP_PARAMS = dict(
    hidden_layer_sizes=(256, 128, 64, 32, 16),  # pyramid structure
    activation="relu",
    alpha=0.01,                # L2 regularization
    batch_size=32,
    learning_rate_init=0.01,
    max_iter=2000,
    early_stopping=True,
    validation_fraction=0.1,
    n_iter_no_change=20,
    random_state=RANDOM_STATE,
    shuffle=True,
)


# ---------- File selection ----------
def select_files(title):
    root = tk.Tk()
    root.withdraw()
    files = askopenfilenames(title=title, filetypes=[("CSV files", "*.csv")])
    return sorted(files)


# ---------- Raw data parsing ----------
def read_xy(file):
    try:
        df = pd.read_csv(file, header=0, encoding="utf-8")
    except UnicodeDecodeError:
        df = pd.read_csv(file, header=0, encoding="cp949")
    x = pd.to_numeric(df.iloc[:, 0], errors="coerce")
    y = pd.to_numeric(df.iloc[:, 3], errors="coerce")
    return x.dropna().values, y.dropna().values


def parse_info(file_name):
    """Extract (set_name, temperature) from a filename, e.g. 'Set1_25.0C'."""
    m = re.search(r"(Set\d+).*?([0-9]+(?:\.[0-9]+)?)\s*[°º]?\s*[C℃]", file_name)
    return (m.group(1), float(m.group(2))) if m else ("Unknown", np.nan)


# ---------- Spectral descriptor extraction ----------
def extract_peak_ev(x, y):
    return 1240 / x[np.argmax(y)]


def extract_ex_ratio(x, y):
    main_mask = (x >= 370) & (x <= 380)
    shoulder_mask = (x >= 340) & (x <= 350)
    if not main_mask.any() or not shoulder_mask.any():
        return np.nan
    return np.max(y[shoulder_mask]) / np.max(y[main_mask])


def extract_ratio_400_shoulder(em_x, em_y, ex_x, ex_y):
    mask = (340 <= ex_x) & (ex_x <= 350)
    if not mask.any():
        return np.nan
    return np.max(ex_y[mask]) / np.max(em_y)


def build_dataset(paths, include_set=False):
    """Match each EmScan file to its ExScan/Em(1)/Em(2) counterparts (same
    set, temperature within 0.2 degC) and compute the five descriptors."""
    records = []
    for file in paths:
        set_name, temp = parse_info(file)
        if "EmScan" not in file or set_name == "Unknown":
            continue

        related = lambda tag: [f for f in paths if tag in f and set_name in f]
        f_ex = next((f for f in related("ExScan") if abs(parse_info(f)[1] - temp) <= 0.2), None)
        f_em1 = next((f for f in related("Em(1)") if abs(parse_info(f)[1] - temp) <= 0.2), None)
        f_em2 = next((f for f in related("Em(2)") if abs(parse_info(f)[1] - temp) <= 0.2), None)
        if not all([f_ex, f_em1, f_em2]):
            continue

        x_em, y_em = read_xy(file)
        x_ex, y_ex = read_xy(f_ex)
        x_em1, y_em1 = read_xy(f_em1)
        x_em2, y_em2 = read_xy(f_em2)

        temps = [temp, parse_info(f_ex)[1], parse_info(f_em1)[1], parse_info(f_em2)[1]]
        T_avg = round(np.mean(temps), 2)

        row = {
            "Temperature": T_avg,
            "Excitation_ratio": extract_ex_ratio(x_ex, y_ex),
            "EmScan_peak_eV": extract_peak_ev(x_em, y_em),
            "Em1_peak_eV": extract_peak_ev(x_em1, y_em1),
            "Em2_peak_eV": extract_peak_ev(x_em2, y_em2),
            "Intensity_400nm_div_shoulder": extract_ratio_400_shoulder(x_em, y_em, x_ex, y_ex),
        }
        if include_set:
            row = {"Set": set_name, **row}

        if not any(np.isnan(row[c]) for c in FEATURE_COLUMNS):
            records.append(row)

    return pd.DataFrame(records)


# ---------- Pyramid MLP with recorded validation loss ----------
class PyramidMLPRegressor(MLPRegressor):
    """Extends sklearn's MLPRegressor to also record an epoch-wise
    validation loss curve (sklearn only exposes the training loss)."""

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.val_loss_curve_ = []
        self.X_val = None
        self.y_val = None

    def set_validation_data(self, X_val, y_val):
        self.X_val = X_val
        self.y_val = y_val

    def fit(self, X, y, X_val=None, y_val=None):
        if X_val is not None and y_val is not None:
            self.set_validation_data(X_val, y_val)

        result = super().fit(X, y)  # sklearn's own fit; unaffected by the below

        if self.X_val is not None and self.y_val is not None:
            self._reconstruct_validation_losses(X, y)
        return result

    def _reconstruct_validation_losses(self, X_train, y_train):
        """Replay training epoch-by-epoch (warm_start) purely to record
        validation MSE at each epoch, then restore the original weights."""
        print("Reconstructing validation losses...")
        final_coefs = [c.copy() for c in self.coefs_]
        final_intercepts = [b.copy() for b in self.intercepts_]

        temp_model = MLPRegressor(
            hidden_layer_sizes=self.hidden_layer_sizes,
            activation=self.activation,
            alpha=self.alpha,
            batch_size=self.batch_size,
            learning_rate_init=self.learning_rate_init,
            max_iter=1,
            early_stopping=False,
            random_state=self.random_state,
            shuffle=self.shuffle,
            warm_start=True,
        )

        self.val_loss_curve_ = []
        for epoch in range(len(self.loss_curve_)):
            temp_model.partial_fit(X_train, y_train)
            val_loss = mean_squared_error(self.y_val, temp_model.predict(self.X_val))
            self.val_loss_curve_.append(val_loss)
            if (epoch + 1) % 10 == 0 or epoch == 0:
                print(f"  Epoch {epoch + 1:3d}: Validation loss = {val_loss:.6f}")

        self.coefs_ = final_coefs
        self.intercepts_ = final_intercepts
        print("Validation loss reconstruction completed!")


def create_pyramid_mlp():
    return PyramidMLPRegressor(**MLP_PARAMS)


# ---------- Reporting ----------
def print_scaling_info(scaler, feature_names):
    print("\nStandard Scaling (Z-score) Information:")
    for i, feature in enumerate(feature_names):
        print(f"  {feature}: mean = {scaler.mean_[i]:.4f}, std = {scaler.scale_[i]:.4f}")


def print_detailed_metrics(name, y_true, y_pred):
    r2 = r2_score(y_true, y_pred)
    mae = mean_absolute_error(y_true, y_pred)
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100
    print(f"{name}:\n  R2: {r2:.4f}\n  MAE: {mae:.4f}°C\n  RMSE: {rmse:.4f}°C\n  MAPE: {mape:.2f}%")


# ---------- Cross-validation ----------
def run_cross_validation(X, y, n_splits=5):
    """5-fold CV: MLP re-instantiated with identical hyperparameters per
    fold; per-fold StandardScaler fitting (train fold only) prevents data
    leakage. Early stopping uses an internal 10% split of the fold-train
    set (validation_fraction=0.1), consistent with the main model."""
    print("\n" + "=" * 60)
    print("5-Fold Cross-Validation (Pyramid MLP)")
    print("=" * 60)

    kf = KFold(n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE)
    mae_list, r2_list = [], []

    for fold, (tr_idx, val_idx) in enumerate(kf.split(X), start=1):
        X_tr, X_vl = X[tr_idx], X[val_idx]
        y_tr, y_vl = y[tr_idx], y[val_idx]

        fold_scaler = StandardScaler()
        X_tr_sc = fold_scaler.fit_transform(X_tr)
        X_vl_sc = fold_scaler.transform(X_vl)

        fold_model = MLPRegressor(**MLP_PARAMS).fit(X_tr_sc, y_tr)
        y_vl_pred = fold_model.predict(X_vl_sc)

        fold_mae = mean_absolute_error(y_vl, y_vl_pred)
        fold_r2 = r2_score(y_vl, y_vl_pred)
        mae_list.append(fold_mae)
        r2_list.append(fold_r2)
        print(f"  Fold {fold}: MAE = {fold_mae:.4f} °C,  R² = {fold_r2:.4f}")

    print(f"\n  Mean MAE = {np.mean(mae_list):.4f} ± {np.std(mae_list, ddof=1):.4f} °C  (mean ± SD, k={n_splits})")
    print(f"  Mean R²  = {np.mean(r2_list):.4f} ± {np.std(r2_list, ddof=1):.4f}       (mean ± SD, k={n_splits})")
    print("=" * 60)


# ---------- PDP/ICE analysis ----------
def analyze_mlp_pdp_ice(model, X_data, feature_names, save_dir=None):
    """PDP (average) and ICE (per-sample) analysis for each feature, with
    a simple curvature/spread-based nonlinearity classification."""
    print("\n[MLP PDP/ICE Analysis Started]")
    print("Pyramid MLP model Partial Dependence Plot (PDP) and Individual Conditional Expectation (ICE) analysis")
    print("Detecting nonlinearity and heterogeneous response patterns by individual samples")
    print("-" * 90)

    if save_dir is None:
        root = tk.Tk()
        root.withdraw()
        save_dir = filedialog.askdirectory(title="Select folder to save MLP PDP/ICE analysis results")
        if not save_dir:
            print("No save folder selected. Skipping analysis.")
            return None

    all_rows = []
    for feature_idx, feature_name in enumerate(feature_names):
        print(f"\nAnalyzing: {feature_name} (Feature {feature_idx + 1}/{len(feature_names)})")
        try:
            pd_results = partial_dependence(model, X_data, [feature_idx], kind="both", grid_resolution=50)
            pdp_values = pd_results["average"][0]
            ice_values = pd_results["individual"][0]
            grid_values = pd_results["grid_values"][0]

            curvature = np.mean(np.abs(np.diff(pdp_values, n=2))) if len(pdp_values) >= 3 else 0
            ice_variability = np.mean(np.var(ice_values, axis=0))
            pdp_range = np.max(pdp_values) - np.min(pdp_values)

            linearity_score = max(0, 1 - (curvature * 100 + ice_variability / (pdp_range + 1e-10)))
            if linearity_score > 0.8:
                nonlinearity_level = "Weak Nonlinearity"
            elif linearity_score > 0.5:
                nonlinearity_level = "Moderate Nonlinearity"
            else:
                nonlinearity_level = "Strong Nonlinearity"

            common = {
                "Feature_Name": feature_name, "Feature_Index": feature_idx,
                "PDP_Curvature": curvature, "ICE_Variability": ice_variability,
                "Linearity_Score": linearity_score, "Nonlinearity_Level": nonlinearity_level,
            }
            for grid_idx, grid_val in enumerate(grid_values):
                all_rows.append({**common, "Grid_Value": grid_val, "PDP_Value": pdp_values[grid_idx],
                                  "Type": "PDP", "Sample_Index": -1, "ICE_Value": np.nan})
                for sample_idx in range(ice_values.shape[0]):
                    all_rows.append({**common, "Grid_Value": grid_val, "PDP_Value": pdp_values[grid_idx],
                                      "Type": "ICE", "Sample_Index": sample_idx,
                                      "ICE_Value": ice_values[sample_idx, grid_idx]})

            print(f"  {feature_name} analysis completed - {nonlinearity_level} detected")
        except Exception as e:
            print(f"  Error analyzing {feature_name}: {e}")

    if not all_rows:
        print("Failed to generate MLP PDP/ICE data.")
        return None

    pdp_ice_df = pd.DataFrame(all_rows)
    pdp_ice_df.to_csv(os.path.join(save_dir, "MLP_PDP_ICE_Analysis_Data.csv"), index=False)
    print("\nAll MLP PDP/ICE data saved: MLP_PDP_ICE_Analysis_Data.csv")

    summary_stats = []
    for feature_name in feature_names:
        fdata = pdp_ice_df[pdp_ice_df["Feature_Name"] == feature_name]
        pdp_data, ice_data = fdata[fdata["Type"] == "PDP"], fdata[fdata["Type"] == "ICE"]
        if pdp_data.empty or ice_data.empty:
            continue

        ice_spread = [
            grp["ICE_Value"].max() - grp["ICE_Value"].min()
            for _, grp in ice_data.groupby("Grid_Value") if len(grp) > 1
        ]
        summary_stats.append({
            "Feature_Name": feature_name,
            "PDP_Range_DegC": pdp_data["PDP_Value"].max() - pdp_data["PDP_Value"].min(),
            "PDP_Curvature": pdp_data["PDP_Curvature"].iloc[0],
            "Avg_ICE_Std_DegC": ice_data.groupby("Grid_Value")["ICE_Value"].std().mean(),
            "Max_ICE_Spread_DegC": max(ice_spread) if ice_spread else 0,
            "Grid_Points": len(pdp_data),
            "Total_Samples": len(ice_data) // len(pdp_data),
            "Linearity_Score": pdp_data["Linearity_Score"].iloc[0],
            "Nonlinearity_Level": pdp_data["Nonlinearity_Level"].iloc[0],
            "Model_Type": "Pyramid MLP (256→128→64→32→16)",
            "Total_Parameters": "Calculated",
            "Activation_Function": "ReLU",
        })

    summary_df = pd.DataFrame(summary_stats)
    summary_df.to_csv(os.path.join(save_dir, "MLP_PDP_ICE_Summary.csv"), index=False)
    print("MLP PDP/ICE summary statistics saved: MLP_PDP_ICE_Summary.csv")
    print(f"\nMLP PDP/ICE analysis completed!\nSave location: {save_dir}")
    print(f"Total analyzed data points: {len(all_rows):,}")

    print("\nMLP model feature-wise nonlinearity analysis summary:")
    print("-" * 60)
    for _, row in summary_df.iterrows():
        print(f"{row['Feature_Name']}:")
        print(f"  PDP Range: {row['PDP_Range_DegC']:.3f}°C")
        print(f"  PDP Curvature: {row['PDP_Curvature']:.4f}")
        print(f"  ICE Avg Std: {row['Avg_ICE_Std_DegC']:.3f}°C")
        print(f"  ICE Max Spread: {row['Max_ICE_Spread_DegC']:.3f}°C")
        print(f"  Nonlinearity Level: {row['Nonlinearity_Level']}")
        print(f"  Linearity Score: {row['Linearity_Score']:.3f}")

    return save_dir


# ---------- Learning curve ----------
def plot_learning_curves(model, save_dir=None):
    """Print training/validation MSE loss summary (no plot; CSV export is
    handled separately by save_learning_curve_data)."""
    if not hasattr(model, "loss_curve_"):
        print("No learning curve data available.")
        return None, None

    train_losses = model.loss_curve_
    val_losses = getattr(model, "val_loss_curve_", [])
    print("Method: sklearn performance + validation loss recording")

    min_train_epoch = np.argmin(train_losses) + 1
    print(f"\nPyramid MLP Training Analysis:")
    print(f"  Network structure: {model.hidden_layer_sizes}")
    print(f"  Activation function: {model.activation}")
    print(f"  Total epochs: {len(train_losses)}")
    print(f"  Final training loss (MSE): {train_losses[-1]:.6f}")
    print(f"  Minimum training loss (MSE): {min(train_losses):.6f} (epoch {min_train_epoch})")

    if val_losses:
        min_val_epoch = np.argmin(val_losses) + 1
        min_val_loss = min(val_losses)
        print(f"  Final validation loss (MSE): {val_losses[-1]:.6f}")
        print(f"  Minimum validation loss (MSE): {min_val_loss:.6f} (epoch {min_val_epoch})")

        final_ratio_excess = val_losses[-1] / train_losses[-1]
        min_val_train_ratio = min_val_loss / train_losses[min_val_epoch - 1]
        if final_ratio_excess > 1.5:
            print(f"  Warning: Possible overfitting - final validation loss is {(final_ratio_excess-1)*100:.1f}% higher than training loss")
        elif min_val_train_ratio < 0.8:
            print(f"  Warning: Possible underfitting - ratio at min validation loss = {min_val_train_ratio:.3f}")
        else:
            print(f"  Appropriate learning - ratio at min validation loss = {min_val_train_ratio:.3f}")

    return train_losses, val_losses


def _change_rate(series):
    """Percent decrease from the previous epoch (0 for the first epoch)."""
    rates = [0]
    for i in range(1, len(series)):
        rates.append((series[i - 1] - series[i]) / series[i - 1] * 100 if series[i - 1] != 0 else 0)
    return rates


def save_learning_curve_data(model, save_dir):
    """Save per-epoch training/validation MSE loss (and summary stats) to CSV."""
    if not hasattr(model, "loss_curve_"):
        print("No learning curve data available.")
        return None

    train_losses = model.loss_curve_
    val_losses = getattr(model, "val_loss_curve_", [])
    epochs = list(range(1, len(train_losses) + 1))

    data = {
        "Epoch": epochs,
        "Training_Loss_MSE": train_losses,
        "Train_Loss_Change_Rate_Percent": _change_rate(train_losses),
    }
    if val_losses and len(val_losses) == len(train_losses):
        data["Validation_Loss_MSE"] = val_losses
        data["Val_Loss_Change_Rate_Percent"] = _change_rate(val_losses)
        data["Val_Train_Loss_Ratio"] = [v / t if t != 0 else np.inf for v, t in zip(val_losses, train_losses)]

    min_train_epoch = np.argmin(train_losses) + 1
    data["Is_Min_Training_Loss_Epoch"] = [e == min_train_epoch for e in epochs]
    if val_losses:
        min_val_epoch = np.argmin(val_losses) + 1
        data["Is_Min_Validation_Loss_Epoch"] = [e == min_val_epoch for e in epochs]

    learning_curve_df = pd.DataFrame(data)

    if not save_dir:
        print("Training/validation learning curve data prepared in memory (not saved - no folder selected)")
        return learning_curve_df

    csv_file = os.path.join(save_dir, "pyramid_mlp_train_val_learning_data.csv")
    learning_curve_df.to_csv(csv_file, index=False)
    print(f"Training/validation learning curve data saved: {csv_file}")

    total_params = sum(model.coefs_[i].size + model.intercepts_[i].size for i in range(len(model.coefs_)))
    summary = {
        "Metric": ["Total_Epochs", "Min_Training_Loss_Epoch", "Min_Training_Loss_MSE",
                   "Final_Training_Loss_MSE", "Initial_Training_Loss_MSE", "Training_Loss_Improvement_Percent",
                   "Network_Structure", "Total_Parameters", "Activation_Function", "Learning_Rate",
                   "Alpha_Regularization", "Batch_Size", "Loss_Function", "Method"],
        "Value": [len(train_losses), min_train_epoch, min(train_losses), train_losses[-1], train_losses[0],
                  (train_losses[0] - train_losses[-1]) / train_losses[0] * 100, str(model.hidden_layer_sizes),
                  total_params, model.activation, model.learning_rate_init, model.alpha, model.batch_size,
                  "MSE (Mean Squared Error)", "sklearn + validation tracking"],
    }
    if val_losses:
        min_val_epoch = np.argmin(val_losses) + 1
        summary["Metric"] += ["Min_Validation_Loss_Epoch", "Min_Validation_Loss_MSE",
                               "Final_Validation_Loss_MSE", "Val_Train_Loss_Ratio_at_Min_Val_Epoch"]
        summary["Value"] += [min_val_epoch, min(val_losses), val_losses[-1],
                              val_losses[min_val_epoch - 1] / train_losses[min_val_epoch - 1]]

    summary_file = os.path.join(save_dir, "pyramid_mlp_training_summary.csv")
    pd.DataFrame(summary).to_csv(summary_file, index=False)
    print(f"Training summary information saved: {summary_file}")
    return learning_curve_df


# ---------- Output ----------
def save_test_results(df_test, y_test, y_test_pred):
    results = df_test.copy()
    results["Predicted_Temperature"] = y_test_pred
    results["Residual"] = y_test - y_test_pred
    results["Abs_Residual"] = (y_test - y_test_pred).abs()
    results["R2_Score"] = r2_score(y_test, y_test_pred)
    results["MAE"] = mean_absolute_error(y_test, y_test_pred)
    results["RMSE"] = np.sqrt(mean_squared_error(y_test, y_test_pred))

    save_path = asksaveasfilename(
        title="Save Pyramid MLP test results",
        defaultextension=".csv",
        filetypes=[("CSV files", "*.csv")],
        initialfile="pyramid_mlp_results.csv",
    )
    if save_path and not os.path.isdir(save_path):
        results.to_csv(save_path, index=False)
        print(f"Pyramid MLP results saved: {save_path}")
    else:
        print("Failed to save test results.")


# ---------- Main ----------
def main():
    train_val_paths = select_files("Select training and validation data files")
    df = build_dataset(train_val_paths, include_set=True)
    if df.empty:
        print("No valid data available for model training.")
        return

    X = df[FEATURE_COLUMNS]
    y = df["Temperature"]
    X_train, X_val, y_train, y_val = train_test_split(X, y, test_size=0.2, random_state=RANDOM_STATE)

    print("\n[Applying Standard Scaling (Z-score)...]")
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    X_val_scaled = scaler.transform(X_val)
    print("Standard Scaling applied.")
    print_scaling_info(scaler, FEATURE_COLUMNS)

    print("\n[Training Pyramid MLP Model...]")
    print(f"Architecture: {MLP_PARAMS['hidden_layer_sizes']}")
    print(f"Activation function: {MLP_PARAMS['activation']}")
    print(f"Regularization: α = {MLP_PARAMS['alpha']}")
    print(f"Batch size: {MLP_PARAMS['batch_size']}")
    print("Method: sklearn performance + additional validation loss recording")

    model = create_pyramid_mlp()
    model.fit(X_train_scaled, y_train, X_val_scaled, y_val)

    print("\nPyramid MLP model training completed!")
    print(f"Training iterations: {model.n_iter_}")
    print(f"Final training loss: {model.loss_:.6f}")
    if model.val_loss_curve_:
        print(f"Final validation loss: {model.val_loss_curve_[-1]:.6f}")

    print("\n[Training/Validation Results]")
    print_detailed_metrics("Training", y_train, model.predict(X_train_scaled))
    print_detailed_metrics("Validation", y_val, model.predict(X_val_scaled))

    run_cross_validation(X.values, y.values)

    print("\n" + "=" * 90)
    print("MLP PDP/ICE analysis starting!")
    print("This analysis shows nonlinear patterns learned by the pyramid MLP model.")
    print("PDP: Average nonlinear effects")
    print("ICE: Individual sample nonlinear effects")
    print("Discover nonlinearity and individual sample heterogeneity!")
    print("=" * 90)
    mlp_pdp_save_dir = analyze_mlp_pdp_ice(model, X_train_scaled, FEATURE_COLUMNS)

    print("\n[Pyramid MLP Learning Curve Analysis]")
    if mlp_pdp_save_dir:
        save_dir = mlp_pdp_save_dir
        print(f"Using same directory as PDP/ICE analysis: {save_dir}")
    else:
        root = tk.Tk()
        root.withdraw()
        save_dir = filedialog.askdirectory(title="Select folder to save learning curve data") or None

    plot_learning_curves(model, save_dir)
    save_learning_curve_data(model, save_dir)
    if save_dir:
        print(f"Learning curve files saved: {save_dir}")
        print("Generated files:")
